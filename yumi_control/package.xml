<?xml version="1.0"?>
<package format="3">
  <name>yumi_control</name>
  <version>0.0.0</version>
  <description>Custom node to move ABB YuMi arms to specified poses using MoveIt2</description>

  <maintainer email="erpeetersons2002@gmail.com">Ernests Petersons</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>moveit2</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
